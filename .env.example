# ============================================================================
# KnowYourGov - application environment (iv-app)
# Copy to `.env` on the app host. Never commit `.env`.
# ============================================================================

# --- Required: database ------------------------------------------------------
# PostgreSQL 16 on the data host (VPC address; never publicly reachable).
DATABASE_URL="postgresql://informedvoter:CHANGE_ME@10.39.112.20:5432/informedvoter?schema=public"

# --- Required: rate limiting -------------------------------------------------
# Redis 7 on the data host. If unset or unreachable the limiter fails open.
REDIS_URL="redis://:CHANGE_ME@10.39.112.20:6379"

# --- Required: cron authentication -------------------------------------------
# Generate with: openssl rand -hex 32
# Used by the host crontab (Bearer header) and the /api/ai/* endpoints.
CRON_SECRET=

# --- Required: public base URL ------------------------------------------------
# Used for canonical URLs, email links and same-origin request checks.
NEXT_PUBLIC_BASE_URL=https://knowyourgov.us

# --- Data APIs ----------------------------------------------------------------
CONGRESS_GOV_API_KEY=
FEC_API_KEY=
GOOGLE_CIVIC_API_KEY=

# Optional. CourtListener returns 401 for invalid tokens; disclosures are
# skipped when this is empty.
COURTLISTENER_API_TOKEN=

# Optional. Not currently used by any sync job (no LegiScan integration).
LEGISCAN_API_KEY=

# --- AI (optional) ------------------------------------------------------------
# When empty: AI cron jobs skip cleanly and /api/local/template returns 503.
ANTHROPIC_API_KEY=

# --- Email (optional) ---------------------------------------------------------
# When empty: /api/subscribe returns 503 and the subscribe UI is hidden.
RESEND_API_KEY=
EMAIL_FROM="KnowYourGov <notifications@knowyourgov.us>"

# --- Analytics (optional) -----------------------------------------------------
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.knowyourgov.us/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_DATABASE_URL="postgresql://informedvoter:CHANGE_ME@10.39.112.20:5432/umami"
UMAMI_APP_SECRET=

# --- TLS (optional) -----------------------------------------------------------
# TLS uses a Cloudflare Origin CA certificate mounted at docker/certs/.
# Only needed if the host must call the Cloudflare API.
CF_API_TOKEN=

# --- Development only ---------------------------------------------------------
# NEVER set in production: allows ?manual=true to bypass cron auth in dev.
# ALLOW_MANUAL_CRON=true
