# KnowYourGov — Caddyfile
# Serve the site behind a TLS reverse proxy. Set SITE_DOMAIN (and
# CERT_FILE/CERT_KEY if you use custom certificates) in your `.env`.
# The app container is reachable as `app:3000` on the compose network.
# ═══════════════════════════════════════════════════════════════════════════

{
	email admin@example.com
}

# ── Main site ────────────────────────────────────────────────────────────────
{$SITE_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy app:3000
}
